---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, profile } from '../content/site';

type Props = { title: string; description: string; image?: string; home?: boolean; noindex?: boolean };
const { title, description, image = '/og.png', home = false, noindex = false } = Astro.props;
// build.format 'file' makes the build-time path /about.html; Vercel serves it as /about
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '');
const canonical = `${SITE_URL}${path || '/'}`;
const fullTitle = home ? `${profile.name} | Textbooks, clubs and research` : `${title} | ${profile.name}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: SITE_URL,
  email: profile.email,
  affiliation: {
    '@type': 'HighSchool',
    name: profile.school,
    address: { '@type': 'PostalAddress', addressLocality: 'Apple Valley', addressRegion: 'MN', addressCountry: 'US' },
  },
  sameAs: [profile.github],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}${image}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { if (localStorage.getItem('theme') === 'light') d.setAttribute('data-theme', 'light'); } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
