---
import Base from '../layouts/Base.astro';
import ButtonLink from '../components/ButtonLink.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="nf">
    <canvas class="page-art" data-art="sphere" aria-hidden="true"></canvas>
    <div class="wrap">
      <h1>Nothing <em>here</em></h1>
      <p class="lede">That page doesn’t exist, or it moved when I rebuilt the site.</p>
      <div class="btn-row"><ButtonLink link={{ label: 'Go home', href: '/' }} /><ButtonLink link={{ label: 'See what I’ve built', href: '/built' }} variant="ghost" /></div>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; min-height: 80svh; display: flex; align-items: center; padding-top: 64px; overflow: hidden; }
  .nf .wrap { position: relative; z-index: 1; }
  .lede { color: var(--muted); font-size: var(--step-1); margin: var(--space-5) 0 var(--space-6); }
</style>
