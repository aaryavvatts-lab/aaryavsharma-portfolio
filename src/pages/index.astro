---
import Base from '../layouts/Base.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Stats from '../components/Stats.astro';
import { books, home, profile } from '../content/site';
import film from '../content/film.json';

const spines = ['#1b2554', '#3a1e62', '#0c4f49'];
const poster = film.poster;
---
<Base
  home
  title="Home"
  description="Aaryav Sharma, a sophomore at Eastview High School in Minnesota: three free interactive textbooks (about 704,000 words) and two school clubs, SASA and NeuroGIDAS."
>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={poster.land.map((p) => `${p.avif} ${p.w}w`).join(', ')} imagesizes="100vw" fetchpriority="high" media="(min-aspect-ratio: 4001/5000)" />
    <link rel="preload" as="image" type="image/avif" href={poster.port.avif} fetchpriority="high" media="(max-aspect-ratio: 4/5)" />
  </Fragment>

  <!-- The film: a night reading room, pushed into by scrolling, ending on a page of Roots & Rivers. -->
  <section class="film" id="top" data-film aria-labelledby="hero-title" style={`--poster-x:${film.focal.land[0][0] * 100}%;--poster-y:${film.focal.land[0][1] * 100}%`}>
    <div class="film__stage">
      <picture class="film__poster">
        <source media="(max-aspect-ratio: 4/5)" type="image/avif" srcset={poster.port.avif} />
        <source media="(max-aspect-ratio: 4/5)" srcset={poster.port.src} />
        <source type="image/avif" srcset={poster.land.map((p) => `${p.avif} ${p.w}w`).join(', ')} sizes="100vw" />
        <img src={poster.land[1].src} srcset={poster.land.map((p) => `${p.src} ${p.w}w`).join(', ')} sizes="100vw"
          width="1920" height="1080" alt="" fetchpriority="high" decoding="async" />
      </picture>
      <canvas class="film__canvas" aria-hidden="true"></canvas>
      <div class="film__grain" aria-hidden="true"></div>
      <div class="film__copy" data-film-copy>
        <h1 id="hero-title">Aaryav Sharma</h1>
        <p class="film__lede">{home.lede}</p>
        <p class="film__cue" aria-hidden="true"><span></span>Scroll into the book</p>
      </div>
      <div class="film__paper" aria-hidden="true" data-film-paper></div>
    </div>
  </section>

  <div class="book" data-paper>
    <!-- Chapter 1: the three textbooks -->
    <section class="spread" id="textbooks" aria-labelledby="tb-title">
      <div class="page page--wide">
        <p class="runhead">Aaryav Sharma <span>The books</span></p>
        <div class="tb-head">
          <h2 id="tb-title">{home.books.title}</h2>
          <div class="tb-copy">
            <p class="cause dropcap">{home.books.why}</p>
            <p>{home.books.did}</p>
            <p class="result">{home.books.result}</p>
          </div>
        </div>
        <ul class="shelf" role="list">
          {books.map((b, i) => (
            <li class="shelf__item">
              <a class="b3" href={b.url} target="_blank" rel="noopener" style={`--spine:${spines[i]}`} data-tilt>
                <span class="b3__body">
                  <img class="b3__front" src={b.cover} alt="" width="800" height="1200" loading="lazy" decoding="async" />
                  <span class="b3__spine" aria-hidden="true"></span>
                  <span class="b3__pages" aria-hidden="true"></span>
                </span>
                <span class="b3__caption"><b>{b.name}</b><span>{b.subject}</span></span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="table-wrap" tabindex="0" role="region" aria-label="What is in each textbook">
          <table class="ledger">
            <caption class="visually-hidden">What is in each textbook, counted from its source files</caption>
            <thead><tr><th scope="col"><span class="visually-hidden">Measure</span></th>{books.map((b) => <th scope="col">{b.name}</th>)}</tr></thead>
            <tbody>
              <tr><th scope="row">Words</th>{books.map((b) => <td>{b.words}</td>)}</tr>
              <tr><th scope="row">Chapters, each with a simulation</th>{books.map((b) => <td>{b.chapters}</td>)}</tr>
              <tr><th scope="row">Quiz questions</th>{books.map((b) => <td>{b.quiz}</td>)}</tr>
              <tr><th scope="row">Glossary terms</th>{books.map((b) => <td>{b.glossary}</td>)}</tr>
              <tr><th scope="row">Sourced references</th>{books.map((b) => <td>{b.refs}</td>)}</tr>
              <tr><th scope="row">Google Analytics users since launch</th>{books.map((b) => <td>{b.readers ?? 'New'}</td>)}</tr>
            </tbody>
          </table>
        </div>
        <p class="folio">1</p>
      </div>
    </section>

    <!-- Chapter 2: SASA -->
    <section class="spread" id="sasa" aria-labelledby="sasa-title">
      <div class="page page--left">
        <p class="runhead">Aaryav Sharma</p>
        <h2 id="sasa-title">{home.sasa.title}</h2>
        <p class="role">{home.sasa.role}</p>
        <p class="cause dropcap">{home.sasa.why}</p>
        <p>{home.sasa.did}</p>
        <p class="result">{home.sasa.result}</p>
        <div class="btn-row">{home.sasa.links.map((l) => <ButtonLink link={l} variant="ghost" class="btn--ink" />)}</div>
        <p class="folio">2</p>
      </div>
      <div class="page page--right">
        <p class="runhead runhead--right">The clubs</p>
        <blockquote class="pull">“Growing up, I felt scared to show my culture.”</blockquote>
        <Stats stats={home.sasa.stats} class="stats--ink stats--big" />
        <figure class="plate plate--tipped">
          <a href="https://aaryavvatts-lab.github.io/south-asian-culture-textbook/" target="_blank" rel="noopener" aria-label="Open Roots & Rivers (opens in a new tab)">
            <img src="/img/shots/roots-rivers.webp" alt="The Roots & Rivers home page, with its peacock mascot and chapter list." width="1200" height="750" loading="lazy" decoding="async" />
          </a>
          <figcaption>Roots &amp; Rivers, the textbook I wrote for the club.</figcaption>
        </figure>
        <p class="folio folio--right">3</p>
      </div>
    </section>

    <!-- Chapter 3: NeuroGIDAS -->
    <section class="spread" id="neurogidas" aria-labelledby="gidas-title">
      <div class="page page--left">
        <p class="runhead">Aaryav Sharma</p>
        <h2 id="gidas-title">{home.gidas.title}</h2>
        <p class="role">{home.gidas.role}</p>
        <p class="cause dropcap">{home.gidas.why}</p>
        <p>{home.gidas.did}</p>
        <p class="result">{home.gidas.result}</p>
        <div class="btn-row">{home.gidas.links.map((l) => <ButtonLink link={l} variant="ghost" class="btn--ink" />)}</div>
        <p class="folio">4</p>
      </div>
      <div class="page page--right page--emblem">
        <p class="runhead runhead--right">The clubs</p>
        <Stats stats={home.gidas.stats} class="stats--ink stats--big" />
        <figure class="plate plate--emblem">
          <img src="/img/neurogidas.png" alt="The NeuroGIDAS emblem." width="520" height="520" loading="lazy" decoding="async" />
        </figure>
        <p class="folio folio--right">5</p>
      </div>
    </section>
  </div>

  <!-- Back cover -->
  <section class="close" aria-labelledby="close-title">
    <div class="wrap">
      <h2 id="close-title">{home.close.title}</h2>
      <ul class="stats stats--close" role="list">
        {home.close.stats.map((s) => <li class="stat"><b data-count={s.value}>{s.value}</b> <span>{s.label}</span></li>)}
      </ul>
      <p class="close__note">I also redid the analysis on ten public brain and medical datasets. They are on the <a href="/built#research">Built</a> page.</p>
      <p class="close__note close__note--small">{home.close.note}</p>
      <div class="btn-row close__actions">
        <ButtonLink link={{ label: 'Get in touch', href: '/contact' }} />
        <ButtonLink link={{ label: 'Resume', href: profile.resume, external: true }} variant="ghost" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- film ---------- */
  .film { position: relative; height: 100vh; height: 100svh; background: #050403; }
  :global(html[data-film-tall]) .film { height: 420vh; }
  .film__stage { position: sticky; top: 0; height: 100%; overflow: hidden; }
  :global(html[data-film-tall]) .film__stage { height: 100vh; height: 100lvh; }
  .film__poster, .film__poster img, .film__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .film__poster img { object-fit: cover; object-position: var(--poster-x, 50%) var(--poster-y, 50%); }
  .film__canvas { opacity: 0; }
  :global(html[data-film-state='on']) .film__canvas { opacity: 1; }
  .film__grain {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.08; mix-blend-mode: overlay;
    background-image: url('/img/grain.png'); background-size: 192px 192px;
  }
  @media (pointer: coarse) { .film__grain { display: none; } }
  .film__copy {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 0 var(--gutter) calc(max(7svh, 3rem) + (100lvh - 100svh));
    max-width: calc(var(--max) + 2 * var(--gutter)); margin-inline: auto; will-change: opacity, transform;
  }
  .film__copy h1 { font-size: clamp(3.2rem, 1.6rem + 6vw, 7.6rem); font-weight: 380; letter-spacing: -0.025em; line-height: 0.95; color: #f3ead8; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.5); }
  .film__lede { max-width: 40rem; margin: var(--space-5) 0 var(--space-6); font-size: var(--step-1); line-height: 1.55; color: #ddd2bd; text-shadow: 0 1px 18px rgba(0, 0, 0, 0.75); }
  .film__cue { display: flex; align-items: center; gap: 0.75rem; margin: 0; font-size: 0.85rem; color: #cbbfa8; letter-spacing: 0.02em; }
  .film__cue span { width: 44px; height: 1px; background: #cbbfa8; transform-origin: left; animation: cue 2.4s var(--ease) infinite; }
  @keyframes cue { 0% { transform: scaleX(0.2); } 60%, 100% { transform: scaleX(1); } }
  .film__paper { position: absolute; inset: 0; background: var(--paper); opacity: 0; pointer-events: none; }

  /* ---------- the book ---------- */
  .book { --focus: var(--ink-accent); background: var(--paper); color: var(--ink); position: relative; z-index: 1; padding: var(--space-7) 0 var(--space-9); overflow-x: clip; perspective: 2400px; }
  .spread {
    position: relative; width: min(100% - 2 * var(--gutter), 1280px); margin: 0 auto var(--space-9);
    display: grid; grid-template-columns: 1fr 1fr; background: var(--paper);
    box-shadow: 0 1px 0 var(--ink-line), 0 40px 70px -46px rgba(60, 40, 20, 0.45);
  }
  .spread::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 60px; transform: translateX(-50%); pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(60, 40, 20, 0.09) 45%, rgba(60, 40, 20, 0.13) 50%, rgba(60, 40, 20, 0.09) 55%, transparent);
  }
  .spread:has(.page--wide) { display: block; }
  .spread:has(.page--wide)::after { display: none; }
  .page { position: relative; padding: clamp(2.5rem, 5vw, 5rem) clamp(1.5rem, 4.5vw, 4.5rem) clamp(4rem, 6vw, 5.5rem); min-width: 0; }
  .book .runhead { font-family: var(--serif); font-variant: small-caps; letter-spacing: 0.06em; font-size: 0.95rem; color: var(--ink-muted); margin: 0 0 var(--space-7); display: flex; justify-content: space-between; max-width: none; }
  .book .runhead--right { justify-content: flex-end; }
  .book .folio { position: absolute; bottom: clamp(1.5rem, 3vw, 2.5rem); left: clamp(1.5rem, 4.5vw, 4.5rem); margin: 0; font-family: var(--serif); color: var(--ink-muted); font-size: 0.95rem; }
  .book .folio--right { left: auto; right: clamp(1.5rem, 4.5vw, 4.5rem); }
  .book h2 { font-size: var(--step-4); color: var(--ink); margin-bottom: var(--space-5); }
  .book p { font-family: var(--serif); font-size: clamp(1.08rem, 1rem + 0.3vw, 1.22rem); line-height: 1.62; max-width: 34em; }
  .book .role { font-family: var(--sans); font-size: var(--step--1); color: var(--ink-accent); font-weight: 600; margin-top: calc(var(--space-3) * -1); }
  .cause { color: var(--ink-muted); }
  .result { font-weight: 560; }
  .dropcap::first-letter { float: left; font-family: var(--serif); font-size: 3.6em; line-height: 0.82; padding: 0.06em 0.1em 0 0; color: var(--ink-accent); font-weight: 500; }
  .book .btn-row { margin-top: var(--space-6); }
  .book :global(.btn--ink) { border-color: var(--ink-line); color: var(--ink); }
  .book :global(.btn--ink:hover) { border-color: var(--ink); }
  .book a:not(.btn):not(.b3) { color: var(--ink-accent); }

  .tb-head { display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: var(--space-7); align-items: start; }
  .tb-head h2 { font-size: var(--step-5); line-height: 0.98; }

  /* three books standing on a shelf, turning as you scroll */
  .shelf { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 4rem); margin: var(--space-8) 0 var(--space-7); padding: 0 0 var(--space-5); border-bottom: 10px solid #b58a5c; box-shadow: 0 14px 18px -12px rgba(60, 40, 20, 0.5); }
  .b3 { display: grid; justify-items: center; gap: var(--space-4); text-decoration: none; color: var(--ink); perspective: 1400px; }
  .b3__body {
    position: relative; width: min(100%, 220px); aspect-ratio: 2 / 3; transform-style: preserve-3d;
    transform: rotateY(calc(-34deg + var(--tilt, 0) * 30deg)) rotateX(3deg);
    transition: transform 0.7s var(--ease);
  }
  .b3:hover .b3__body, .b3:focus-visible .b3__body { transform: rotateY(-6deg) translateY(-10px) rotateX(2deg); }
  .b3__front { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 2px 5px 5px 2px; transform: translateZ(14px); box-shadow: inset 4px 0 6px rgba(0, 0, 0, 0.25); }
  .b3__spine { position: absolute; top: 0; bottom: 0; left: 0; width: 28px; background: var(--spine); transform: translateX(-14px) rotateY(-90deg); box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.45); }
  .b3__pages { position: absolute; top: 3px; bottom: 3px; right: 0; width: 26px; background: repeating-linear-gradient(90deg, #f3ecdc 0 2px, #ddd2ba 2px 3px); transform: translateX(13px) rotateY(90deg); }
  .b3__body::after { content: ''; position: absolute; inset: auto 6% -18px; height: 18px; background: radial-gradient(closest-side, rgba(40, 25, 10, 0.4), transparent); transform: translateZ(-20px); }
  .b3__caption { display: grid; text-align: center; gap: 2px; }
  .b3__caption b { font-family: var(--serif); font-size: 1.15rem; font-weight: 560; }
  .b3__caption span { font-size: var(--step--1); color: var(--ink-muted); max-width: 22ch; }
  .b3:focus-visible { outline: 2px solid var(--ink-accent); outline-offset: 6px; border-radius: 6px; }

  .table-wrap { overflow-x: auto; max-width: 100%; }
  .table-wrap:focus-visible { outline: 2px solid var(--ink-accent); outline-offset: 4px; }
  .ledger { width: 100%; border-collapse: collapse; font-size: var(--step--1); min-width: 560px; }
  .ledger th, .ledger td { padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--ink-line); text-align: right; font-variant-numeric: tabular-nums; }
  .ledger th[scope='row'] { text-align: left; font-weight: 400; color: var(--ink-muted); }
  .ledger thead th { font-family: var(--serif); font-weight: 600; color: var(--ink); vertical-align: bottom; font-size: 1.05rem; }
  .ledger td { font-family: var(--serif); font-size: 1.1rem; color: var(--ink); }

  .pull { margin: 0 0 var(--space-7); font-family: var(--serif); font-style: italic; font-size: var(--step-3); line-height: 1.2; color: var(--ink); max-width: 16ch; padding-left: var(--space-5); border-left: 3px solid var(--ink-accent); }
  .book :global(.stats--ink .stat b) { color: var(--ink); }
  .book :global(.stats--ink .stat span) { color: var(--ink-muted); }
  .book :global(.stats--big) { margin: 0 0 var(--space-6); display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: var(--space-5); }
  .book :global(.stats--big .stat) { min-width: 0; }
  .book :global(.stats--big .stat b) { font-size: var(--step-5); }
  .plate { margin: 0; }
  .plate--tipped { margin-top: var(--space-2); }
  .plate--tipped a { display: block; padding: 10px 10px 12px; background: #f7f1e3; box-shadow: 0 1px 0 rgba(60, 40, 20, 0.08), 0 18px 30px -18px rgba(60, 40, 20, 0.55); transform: rotate(-1.6deg); transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s; }
  .plate--tipped a:hover, .plate--tipped a:focus-visible { transform: rotate(0deg) translateY(-4px); box-shadow: 0 1px 0 rgba(60, 40, 20, 0.08), 0 26px 40px -20px rgba(60, 40, 20, 0.6); }
  .plate--tipped img { display: block; width: 100%; height: auto; }
  .plate--tipped figcaption { margin-top: var(--space-3); font-size: var(--step--1); color: var(--ink-muted); font-style: italic; }
  .plate--emblem img { width: min(70%, 300px); border-radius: 50%; animation: turn 60s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }

  /* ---------- back cover ---------- */
  .close { background: var(--bg); padding: var(--space-9) 0; text-align: center; }
  .close h2 { font-size: var(--step-5); margin-bottom: var(--space-7); }
  .close .stats--close { justify-content: center; gap: var(--space-6) var(--space-8); }
  .close .stats--close .stat span { margin-inline: auto; }
  .close__note { color: var(--muted); max-width: 44ch; margin: var(--space-7) auto 0; font-size: var(--step-1); }
  .close__note a { color: var(--accent); }
  .close__note--small { margin-top: var(--space-4); font-size: var(--step-0); }
  .close__actions { justify-content: center; margin-top: var(--space-6); }

  /* ---------- each spread turns in like a page ---------- */
  :global(.js) .spread { opacity: 0; transform: rotateY(-9deg) translateY(40px); transform-origin: 0 50%; transition: opacity 1s var(--ease), transform 1.2s var(--ease); }
  :global(.js) .spread.is-in { opacity: 1; transform: none; }

  @media (max-width: 860px) {
    .spread { grid-template-columns: 1fr; }
    .spread::after { display: none; }
    .page--right { border-top: 1px solid var(--ink-line); }
    .tb-head { grid-template-columns: 1fr; gap: var(--space-3); }
    .shelf { grid-template-columns: 1fr; justify-items: center; gap: var(--space-7); }
    .b3__body { width: min(62vw, 220px); }
    .ledger { min-width: 0; table-layout: fixed; }
    .ledger th, .ledger td { padding: 0.55rem 0.2rem; }
    .ledger thead th { font-size: 0.86rem; line-height: 1.25; }
    .ledger th[scope='row'] { width: 34%; font-size: 0.78rem; }
    .ledger td { font-size: 0.95rem; }
    :global(html[data-film-tall]) .film { height: 320vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .film { height: 100vh; height: 100svh; }
    .film__stage { height: 100vh; height: 100svh; }
    .film__copy { padding-bottom: max(7svh, 3rem); }
    .film__cue { display: none; }
    :global(.js) .spread { opacity: 1; transform: none; transition: none; }
    .film__cue span, .plate--emblem img { animation: none; }
    .b3__body { transform: rotateY(-20deg); transition: none; }
  }
</style>

<script>
  import { startFilm } from '../scripts/film';
  try { startFilm(); } catch (err) { console.error(err); }
  const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Spreads turn in like pages as they reach the reader; numbers count up once.
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    e.target.classList.add('is-in');
    io.unobserve(e.target);
    if (motion) e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
  }), { rootMargin: '0px 0px -12% 0px' });
  document.querySelectorAll<HTMLElement>('.spread, .close').forEach((s) => io.observe(s));

  function countUp(el: HTMLElement) {
    const text = el.dataset.count ?? '';
    const n = Number(text.replace(/[^0-9]/g, ''));
    if (!n) return;
    const suffix = text.replace(/[0-9,]/g, '');
    const t0 = performance.now(), dur = 1400;
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(n * e).toLocaleString('en-US') + suffix;
      if (k < 1) requestAnimationFrame(step);
      else el.textContent = text;
    };
    requestAnimationFrame(step);
  }

  // The books on the shelf turn toward the reader as the shelf crosses the screen.
  const books = Array.from(document.querySelectorAll<HTMLElement>('[data-tilt]'));
  // The header takes the paper look while it sits over the book's pages.
  const header = document.getElementById('site-header');
  const book = document.querySelector<HTMLElement>('[data-paper]');
  const shelf = document.querySelector<HTMLElement>('.shelf');
  let shelfOn = true, ticking = false;
  if (shelf) new IntersectionObserver(([e]) => { shelfOn = e.isIntersecting; if (shelfOn) update(); }).observe(shelf);
  function update() {
    ticking = false;
    const h = window.innerHeight;
    // read every box first, then write, so the browser lays out once
    const tilts = motion && shelfOn ? books.map((b) => { const r = b.getBoundingClientRect(); return Math.min(1, Math.max(0, 1 - (r.top + r.height / 2) / h)); }) : null;
    const r = book?.getBoundingClientRect();
    tilts?.forEach((t, i) => books[i].style.setProperty('--tilt', t.toFixed(3)));
    if (header && r) header.toggleAttribute('data-paper', r.top < 64 && r.bottom > 32);
  }
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>
